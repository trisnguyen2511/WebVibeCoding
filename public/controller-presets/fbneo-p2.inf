[controller]
name = Arcade Fighter - P2
orientation = landscape

[dpad:MOVE]
x = 7
y = 18
size = 60
up = w
down = s
left = a
right = d
diagonal = true
hold_interval = 50

; ── Column combos (top row) ────────────────────────────────────
; L = LP+LK  |  M = MP+MK  |  H = HP+HK

[combo:L]
label = L
x = 42
y = 11
w = 13
h = 11
chord = g+m

[combo:M]
label = M
x = 56
y = 11
w = 13
h = 11
chord = h+n

[combo:H]
label = H
x = 70
y = 11
w = 13
h = 11
chord = y+p

; ── Punch row ──────────────────────────────────────────────────

[button:LP]
label = LP
key = g
x = 42
y = 26
w = 13
h = 26

[button:MP]
label = MP
key = h
x = 56
y = 26
w = 13
h = 26

[button:HP]
label = HP
key = y
x = 70
y = 26
w = 13
h = 26

[combo:3P]
label = 3P
x = 84
y = 26
w = 7
h = 26
chord = g+h+y

; ── Kick row ───────────────────────────────────────────────────

[button:LK]
label = LK
key = m
