[controller]
name = Arcade Fighter - P4
orientation = landscape

[dpad:MOVE]
x = 5
y = 28
size = 40
up = p4_up
down = p4_down
left = p4_left
right = p4_right
diagonal = true
hold_interval = 50

; ── Column combos (top row) ────────────────────────────────────
; L = LP+LK  |  M = MP+MK  |  H = HP+HK

[combo:L]
label = L
x = 42
y = 8
w = 13
h = 11
chord = p4_lp+p4_lk

[combo:M]
label = M
x = 56
y = 8
w = 13
h = 11
chord = p4_mp+p4_mk

[combo:H]
label = H
x = 70
y = 8
w = 13
h = 11
chord = p4_hp+p4_hk

; ── Punch row ──────────────────────────────────────────────────

[button:LP]
