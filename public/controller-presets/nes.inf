[controller]
name = NES Layout
orientation = landscape

[dpad:MOVE]
x = 3
y = 30
size = 36
up = ArrowUp
down = ArrowDown
left = ArrowLeft
right = ArrowRight
diagonal = true
hold_interval = 60

[button:A]
label = A
key = z
x = 82
y = 50
w = 12
h = 14

[button:B]
label = B
key = x
x = 70
y = 55
w = 12
h = 14

[button:SELECT]
label = SELECT
key = Shift
x = 38
y = 80
w = 16
h = 8

[button:START]
label = START
key = Enter
x = 58
y = 80
w = 16
h = 8

; ── Combos ─────────────────────────────────────────────────────
; Each combo is a dedicated button that sends all chord keys simultaneously

[combo:TURBO_AB]
label = A+B
x = 82
y = 30
w = 12
h = 10
chord = z+x
