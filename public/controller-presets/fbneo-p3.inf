[controller]
name = Arcade Fighter - P3
orientation = landscape

[dpad:MOVE]
x = 7
y = 18
size = 60
up = p3_up
down = p3_down
left = p3_left
right = p3_right
diagonal = true
hold_interval = 50

; ── Column combos (top row) ────────────────────────────────────

[combo:L]
label = L
