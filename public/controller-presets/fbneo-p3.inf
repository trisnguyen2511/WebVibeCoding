[controller]
name = Arcade Fighter - P3
orientation = landscape

[dpad:MOVE]
x = 3
y = 32
size = 36
up = p3_up
down = p3_down
left = p3_left
right = p3_right
diagonal = true
hold_interval = 50

; ── Column combos (top row) ────────────────────────────────────
; L = LP+LK  |  M = MP+MK  |  H = HP+HK

[combo:L]
label = L
x = 42
y = 3
w = 13
h = 11
chord = p3_lp+p3_lk

[combo:M]
label = M
x = 56
y = 3
w = 13
h = 11
chord = p3_mp+p3_mk

[combo:H]
label = H
x = 70
y = 3
w = 13
h = 11
chord = p3_hp+p3_hk

; ── Punch row ──────────────────────────────────────────────────

[button:LP]
label = LP
key = p3_lp
x = 42
y = 17
w = 13
h = 26

[button:MP]
label = MP
key = p3_mp
x = 56
y = 17
w = 13
h = 26

[button:HP]
label = HP
key = p3_hp
x = 70
y = 17
w = 13
h = 26

[combo:3P]
