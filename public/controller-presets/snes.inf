[controller]
name = SNES Layout
orientation = landscape

[dpad:MOVE]
x = 9
y = 21
size = 53
up = ArrowUp
down = ArrowDown
left = ArrowLeft
right = ArrowRight
diagonal = true
hold_interval = 60

[button:A]
label = A
key = z
x = 86
y = 50
w = 11
h = 13

[button:B]
label = B
key = x
x = 76
y = 58
w = 11
h = 13

[button:X]
label = X
key = c
x = 76
y = 42
w = 11
h = 13

[button:Y]
label = Y
key = f
x = 65
y = 50
w = 11
h = 13

[button:L]
label = L
key = q
x = 2
y = 2
w = 18
h = 10

[button:R]
label = R
key = e
x = 80
y = 2
w = 18
h = 10

[button:SELECT]
label = SELECT
key = v
x = 36
y = 78
w = 14
h = 8

[button:START]
label = START
key = Enter
x = 55
y = 78
w = 14
h = 8

; ── Combos ─────────────────────────────────────────────────────
; Each combo is a dedicated button that sends all chord keys simultaneously

[combo:SUPER_JUMP]
label = Super
x = 86
y = 30
w = 11
h = 10
chord = ArrowUp+z

[combo:DASH]
label = Dash
x = 65
y = 30
w = 11
h = 10
chord = x+ArrowRight

[combo:SPECIAL]
label = Spec
x = 36
y = 62
w = 14
h = 10
chord = f+x+z
