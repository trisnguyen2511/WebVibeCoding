[controller]
name = SNES Layout
orientation = landscape

[button:UP]
label = ↑
key = ArrowUp
x = 13
y = 38
w = 10
h = 11
hold = true
hold_delay = 300
hold_interval = 80

[button:DOWN]
label = ↓
key = ArrowDown
x = 13
y = 60
w = 10
h = 11
hold = true
hold_delay = 300
hold_interval = 80

[button:LEFT]
label = ←
key = ArrowLeft
x = 4
y = 49
w = 10
h = 11
hold = true
hold_delay = 300
hold_interval = 80

[button:RIGHT]
label = →
key = ArrowRight
x = 22
y = 49
w = 10
h = 11
hold = true
hold_delay = 300
hold_interval = 80

[button:A]
label = A
key = z
x = 86
y = 50
w = 11
h = 13

[button:B]
label = B
key = x
x = 76
y = 58
w = 11
h = 13

[button:X]
label = X
key = a
x = 76
y = 42
w = 11
h = 13

[button:Y]
label = Y
key = s
x = 65
y = 50
w = 11
h = 13

[button:SELECT]
label = SELECT
key = Shift
x = 36
y = 78
w = 14
h = 8

[button:START]
label = START
key = Enter
x = 55
y = 78
w = 14
h = 8

; ── Combos ─────────────────────────────────────────────────────
; Each combo is a dedicated button that sends all chord keys simultaneously

[combo:SUPER_JUMP]
label = Super
x = 86
y = 30
w = 11
h = 10
chord = ArrowUp+z

[combo:DASH]
label = Dash
x = 65
y = 30
w = 11
h = 10
chord = x+ArrowRight

[combo:SPECIAL]
label = Spec
x = 36
y = 62
w = 14
h = 10
chord = s+x+z
