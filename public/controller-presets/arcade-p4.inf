[controller]
name = Arcade P4
orientation = landscape

; P4 keys — I/B/N/O (up/down/left/right) + P/M/comma/period + 4/8

[dpad:MOVE]
x = 10
y = 13
size = 55
up = i
down = b
left = n
right = o
diagonal = true
hold_interval = 50

[button:ATK]
label = ATK
key = p
x = 58
y = 28
w = 14
h = 18

[button:JMP]
label = JMP
key = m
x = 74
y = 28
w = 14
h = 18

[button:SPL]
label = SPL
key = ,
x = 58
y = 50
w = 14
h = 18

[button:STR]
label = STR
key = .
x = 74
y = 50
w = 14
h = 18

[button:COIN]
label = COIN
key = 8
x = 43
y = 35
w = 12
h = 9

[button:START]
label = START
key = 4
x = 43
y = 50
w = 12
h = 9

; ── Combos ──────────────────────────────────────────────────────

[combo:SUPER]
label = SUPER
x = 86
y = 72
w = 12
h = 10
chord = p+m+,
