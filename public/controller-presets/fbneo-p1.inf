[controller]
name = Arcade Fighter - P1
orientation = landscape

[dpad:MOVE]
x = 7
y = 18
size = 60
up = ArrowUp
down = ArrowDown
left = ArrowLeft
right = ArrowRight
diagonal = true
hold_interval = 50

; ── Column combos (top row) ────────────────────────────────────
; L = LP+LK  |  M = MP+MK  |  H = HP+HK

[combo:L]
label = L
x = 42
y = 11
w = 13
h = 11
chord = f+x

[combo:M]
label = M
x = 56
y = 11
w = 13
h = 11
chord = c+z

[combo:H]
label = H
x = 70
y = 11
w = 13
h = 11
chord = q+e

; ── Punch row ──────────────────────────────────────────────────

[button:LP]
label = LP
key = f
x = 42
y = 26
w = 13
h = 26

[button:MP]
label = MP
key = c
x = 56
y = 26
w = 13
h = 26

[button:HP]
label = HP
key = q
x = 70
y = 26
w = 13
h = 26

[combo:3P]
label = 3P
x = 84
y = 26
w = 7
h = 26
chord = f+c+q

; ── Kick row ───────────────────────────────────────────────────

[button:LK]
label = LK
key = x
x = 42
y = 54
w = 13
h = 26

[button:MK]
label = MK
key = z
x = 56
y = 54
w = 13
h = 26

[button:HK]
label = HK
key = e
x = 70
y = 54
w = 13
h = 26

[combo:3K]
label = 3K
x = 84
y = 54
w = 7
h = 26
chord = x+z+e

; ── System ─────────────────────────────────────────────────────

[button:COIN]
label = COIN
key = v
x = 39
y = 88
w = 10
h = 6

[button:START]
label = START
key = Enter
x = 51
y = 88
w = 10
h = 6
