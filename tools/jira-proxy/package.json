{
  "name": "jira-proxy",
  "version": "1.0.0",
  "description": "Local CORS proxy for internal Jira (Timeline tool)",
  "main": "proxy.js",
  "bin": "proxy.js",
  "scripts": {
    "start": "node proxy.js",
    "build:win": "pkg proxy.js --target node18-win-x64 --output dist/jira-proxy.exe",
    "build:mac": "pkg proxy.js --target node18-macos-x64 --output dist/jira-proxy-mac",
    "build:linux": "pkg proxy.js --target node18-linux-x64 --output dist/jira-proxy-linux"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}
