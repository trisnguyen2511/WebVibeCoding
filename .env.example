NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private Chat admin password (plain text, kept server-side only)
CHAT_ADMIN_PASSWORD=

# Werewolf GM admin password — protects /tools/werewolf-gm/admin (manage saved player groups)
WEREWOLF_ADMIN_PASSWORD=

# Emulator admin password — protects /tools/emulator/admin (upload/delete/rename ROMs)
EMULATOR_ADMIN_PASSWORD=

# Hours since the last tool visit within which the home page still
# auto-jumps back into it (default 3 if unset)
NEXT_PUBLIC_LAST_TOOL_AUTO_ENTER_HOURS=3

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloudinary — used to store images sent in Private Chat (free tier ~25GB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Agnes AI — free image/video generation API, used by /tools/ai-media-studio
# (users can also override this per-request from the tool's UI)
AGNES_AI_API_KEY=

# Meme Party — password protecting /tools/meme-party/library (meme library management).
# Library management stays disabled until this is set.
MEME_ADMIN_PASSWORD=
# Optional tuning: seconds to wait for the Host to return before transferring Host (default 60)
MEME_PARTY_HOST_GRACE_SECONDS=60
# Optional import/upload limits (defaults: 2000 records, 2048 KB import file, 4 MB per image)
MEME_IMPORT_MAX_RECORDS=2000
MEME_IMPORT_MAX_FILE_KB=2048
MEME_UPLOAD_MAX_MB=4
# Force the in-memory store (tests / local dev without Supabase). Never use in production.
# MEME_PARTY_STORE=memory
